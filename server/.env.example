# SoroMint Backend Environment Configuration

# ============================================================================
# CORE APPLICATION SETTINGS
# ============================================================================

PORT=3000
NODE_ENV=development

# ============================================================================
# SOROBAN & STELLAR NETWORK
# ============================================================================

SOROBAN_RPC_URL=https://rpc-futurenet.stellar.org:443
NETWORK_PASSPHRASE=Test SDF Future Network ; October 2022

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

MONGO_URI=mongodb://localhost:27017/soromint
TEST_MONGO_URI=mongodb://localhost:27017/soromint_test

# ============================================================================
# REDIS CONFIGURATION
# ============================================================================

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ============================================================================
# CORS & SECURITY
# ============================================================================

CORS_ALLOWED_ORIGINS=http://localhost:3001,http://localhost:5173
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION=7d

# ============================================================================
# STRIPE CONFIGURATION (BILLING SYSTEM)
# ============================================================================

# Stripe API Keys
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_PUBLIC_KEY=pk_test_your_public_key_here

# Stripe Webhook Secret
# Get this from https://dashboard.stripe.com/webhooks after creating an endpoint
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Optional: Stripe account ID for Connect (if using Stripe Connect)
STRIPE_ACCOUNT_ID=

# ============================================================================
# EMAIL & NOTIFICATIONS
# ============================================================================

SENDGRID_API_KEY=your-sendgrid-api-key
FROM_EMAIL=noreply@soromint.io

# ============================================================================
# AWS S3 CONFIGURATION (BACKUP SYSTEM)
# ============================================================================

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BACKUP_BUCKET=soromint-backups-prod

# ============================================================================
# BACKUP & RECOVERY
# ============================================================================

BACKUP_ENCRYPTION_PASSWORD=your-secure-encryption-password
BACKUP_CRON_SCHEDULE=0 2 * * *
RECOVERY_TEST_CRON_SCHEDULE=0 3 * * *

# ============================================================================
# LOGGING & MONITORING
# ============================================================================

SENTRY_DSN=https://your-sentry-dsn@sentry.io/your-project-id
LOG_LEVEL=info
LOG_DIR=./logs

# ============================================================================
# BRIDGE RELAYER CONFIGURATION
# ============================================================================

BRIDGE_RELAYER_ENABLED=false
BRIDGE_RELAYER_DIRECTION=both
BRIDGE_SOROBAN_ACCOUNT_ID=your-soroban-account-id
BRIDGE_EVM_RPC_URL=https://ethereum-rpc.url
BRIDGE_EVM_BRIDGE_ADDRESS=0x...
BRIDGE_RELAY_ENDPOINT_URL=http://localhost:8080/relay

# ============================================================================
# API KEY & RATE LIMITING
# ============================================================================

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
API_KEY_PREFIX=sk_

# ============================================================================
# FEATURE FLAGS
# ============================================================================

ENABLE_WEBHOOK_INTEGRATION=true
ENABLE_MULTISIG_SUPPORT=true
ENABLE_FRAUD_DETECTION=true
ENABLE_STREAMING_PAYMENTS=true
ENABLE_DAO_FEATURES=true

# ============================================================================
# OAUTH CONFIGURATION
# ============================================================================

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# ============================================================================
# PAGINATION & LIMITS
# ============================================================================

DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
MAX_QUERY_RESULTS=10000

# ============================================================================
# SPONSORSHIP & TRIAL
# ============================================================================

DEFAULT_SPONSORSHIP_BUDGET_STROOPS=1000000
TRIAL_PERIOD_DAYS=14

# ============================================================================
# FEATURE: Tiered Usage Limits
# ============================================================================

# Billing Period Configuration
# Set to 'calendar' for calendar month or 'rolling' for rolling 30 days
BILLING_PERIOD_TYPE=calendar

# Default account tier for new users
DEFAULT_USER_TIER=free

# Soft limit warning threshold (percentage)
DEPLOYMENT_SOFT_LIMIT_PERCENTAGE=80

# Soft limit warning cooldown (hours) - how often to send warnings
SOFT_LIMIT_WARNING_COOLDOWN_HOURS=24

# Operational telemetry
METRICS_USERNAME=prometheus
METRICS_PASSWORD=change-me
LOKI_HOST=http://localhost:3100
LOKI_BASIC_AUTH=
LOG_SERVICE_NAME=soromint-server
